# Public site + ERP frontend (safe to expose; the anon key is gated by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets — NOT build-time env vars.
# Set with: supabase secrets set KEY=value
# These must never be prefixed NEXT_PUBLIC_ or referenced from the frontend: the
# site is a static export, so anything the bundle can read is public.
# See docs/meta-ads.md.
# ---------------------------------------------------------------------------
# META_APP_ID=
# META_APP_SECRET=
# META_TOKEN_ENCRYPTION_KEY=          # 32 random bytes, base64: openssl rand -base64 32
# META_CRON_SECRET=                   # shared secret for the scheduled sync
# ALLOWED_ORIGINS=https://kazimanufacturing.com
# META_GRAPH_VERSION=v23.0            # optional; pin a different Graph version
# META_MAX_DAILY_BUDGET=2000          # optional; ceiling for budget edits, account currency
